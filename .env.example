# Copy to .env (gitignored). Never put the real Atlas URI in git or frontend code.
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/discipline?appName=Cluster0
JWT_SECRET=change-me-to-a-long-random-string
PORT=8787

# Free key from https://fdc.nal.usda.gov/api-guide
# Logging works without it; USDA search needs a key.
VITE_USDA_API_KEY=
